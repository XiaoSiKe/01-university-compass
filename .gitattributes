# Preserve the exact bytes of versioned evidence and packaged Skill files.
* -text

# Newly authored repository presentation and scripts use LF.
README.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
assets/readme/*.svg text eol=lf
scripts/*.py text eol=lf

# Static reading copies are documentation, not a web application.
00_先读说明.html linguist-documentation=true
# Preserve verbatim Markdown line breaks inside transcript <pre> elements.
tests/实际对话记录*.html linguist-documentation=true whitespace=-blank-at-eol,cr-at-eol
tests/**/turn-*.actual-response.txt whitespace=-blank-at-eol,cr-at-eol
tests/**/actual-response.txt whitespace=-blank-at-eol,cr-at-eol
